+    fn wrap_child(child: Applet, complex: bool) -> Applet {
+        let mut defuns = Defuns::new();
+        defuns.add_applet("child", child);
+        let mut config = config(complex);
+        config.set_defuns(defuns);
+        let mut translator = Translator::new(config);
+        translator.set_num_params(2);
+        translator
+            .append_external_fun(&Slot::Temp(0), "child", &[Slot::Param(0), Slot::Param(1)])
+            .unwrap();
+        translator
+            .append_add(&Slot::Out(0), &[Slot::Temp(0), Slot::Param(1)], 0)
+            .unwrap();
+        translator.compile().unwrap().seal().unwrap()
+    }
