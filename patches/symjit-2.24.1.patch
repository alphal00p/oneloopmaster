+/// Call a scalar complex closure once per lane of a packed complex SIMD value.
+///
+/// Complex SIMD values contain all real lanes followed by all imaginary lanes;
+/// they cannot be reinterpreted as interleaved `Complex<f64>` scalar values.
+pub unsafe extern "C" fn trampoline_call_scalar_complex<T>(
+    env: *const c_void,
+    slice_ptr: *const Complex<T>,
+    slice_len: usize,
+    res: *mut Complex<T>,
+) -> bool
+where
+    T: Sized + Copy + Default,
+{
+    assert!(slice_len <= SLICE_CAP && size_of::<T>() >= size_of::<f64>());
+
+    let closure = &*(env as *const ExternalFunction<Complex<f64>>);
+    let lanes = size_of::<T>() / size_of::<f64>();
+    let slice = from_raw_parts(slice_ptr.cast::<f64>(), 2 * lanes * slice_len);
+    let res = from_raw_parts_mut(res.cast::<f64>(), 2 * lanes);
+    let mut buf = [Complex::<f64>::default(); SLICE_CAP];
+
+    for lane in 0..lanes {
+        for arg in 0..slice_len {
+            buf[arg] = Complex::new(
+                slice[2 * arg * lanes + lane],
+                slice[(2 * arg + 1) * lanes + lane],
+            );
+        }
+        let value = closure(&buf[..slice_len]);
+        res[lane] = value.re;
+        res[lanes + lane] = value.im;
+    }
+
+    // The output already has the native packed layout: do not shuffle it.
+    false
+}
