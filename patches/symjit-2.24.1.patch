+#[cfg(test)]
+mod power_tests {
+    use super::*;
+    use crate::Storage;
+
+    #[test]
+    fn zero_argument_constants_support_simd_batches_and_portable_roundtrip() {
+        for complex in [false, true] {
+            for simd in [false, true] {
+                for simd512 in [false, true] {
+                    let mut config = Config::default();
+                    config.set_direct(true);
+                    config.set_complex(complex);
+                    config.set_fastmath(false);
+                    config.set_fast_complex(false);
+                    config.set_simd(simd);
+                    config.enable_simd512(simd512);
+                    config.set_threads(false);
+                    let mut translator = DirectTranslator::new(config.clone());
+                    translator.set_num_params(0);
+                    translator.append_constant(Complex::new(2., 0.)).unwrap();
+                    translator
+                        .append_constant(Complex::new(std::f64::consts::PI, 0.))
+                        .unwrap();
+                    for output in 0..2 {
+                        translator
+                            .append_assign(&Slot::Out(output), &Slot::Const(output))
+                            .unwrap();
+                    }
+                    let application = translator.compile().unwrap();
+                    let mut bytes = Vec::new();
+                    application.save(&mut bytes).unwrap();
+                    let original = application.seal().unwrap();
+                    let restored = Application::load(&mut bytes.as_slice(), &config)
+                        .unwrap()
+                        .seal()
+                        .unwrap();
+                    for evaluator in [&original, &restored] {
+                        assert_eq!(evaluator.count_params, 0);
+                        for rows in [0, 1, 3, 4, 5, 8, 9] {
+                            if complex {
+                                let mut output = vec![Complex::new(f64::NAN, f64::NAN); 2 * rows];
+                                evaluator.evaluate_matrix(&[], &mut output, rows);
+                                for row in output.chunks_exact(2) {
+                                    assert_eq!(row[0], Complex::new(2., 0.));
+                                    assert_eq!(row[1], Complex::new(std::f64::consts::PI, 0.));
+                                }
+                            } else {
+                                let mut output = vec![f64::NAN; 2 * rows];
+                                evaluator.evaluate_matrix(&[], &mut output, rows);
+                                for row in output.chunks_exact(2) {
+                                    assert_eq!(row, &[2., std::f64::consts::PI]);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    fn power_application(complex: bool) -> (Application, Config) {
+        let mut config = Config::default();
+        config.set_opt_level(2);
+        config.set_direct(true);
+        config.set_complex(complex);
+        config.set_fastmath(false);
+        config.set_fast_complex(false);
+        config.set_simd(false);
+        config.set_threads(false);
+        let mut translator = DirectTranslator::new(config.clone());
+        translator.set_num_params(2);
+        translator
+            .append_powf(&Slot::Out(0), &Slot::Param(0), &Slot::Param(1), !complex)
+            .unwrap();
+        (translator.compile().unwrap(), config)
+    }
+
+    #[test]
+    fn direct_powf_real_and_portable_roundtrip() {
+        let (application, config) = power_application(false);
+        let mut bytes = Vec::new();
+        application.save(&mut bytes).unwrap();
+        let original = application.seal().unwrap();
+        let restored = Application::load(&mut bytes.as_slice(), &config)
+            .unwrap()
+            .seal()
+            .unwrap();
+        for [base, exponent] in [[4.0_f64, 0.5], [2.0, -0.25], [0.25, 1.5]] {
+            let expected = base.powf(exponent);
+            for evaluator in [&original, &restored] {
+                let actual = evaluator.evaluate_single(&[base, exponent]);
+                assert!((actual - expected).abs() < 1e-14);
+            }
+        }
+    }
+
+    #[test]
+    fn direct_powf_complex_and_portable_roundtrip() {
+        let (application, config) = power_application(true);
+        let mut bytes = Vec::new();
+        application.save(&mut bytes).unwrap();
+        let original = application.seal().unwrap();
+        let restored = Application::load(&mut bytes.as_slice(), &config)
+            .unwrap()
+            .seal()
+            .unwrap();
+        for (base, exponent) in [
+            (Complex::new(4.0, 0.0), Complex::new(0.5, 0.0)),
+            (Complex::new(1.0, -2.0), Complex::new(0.5, 0.25)),
+            (Complex::new(-2.0, -0.25), Complex::new(-0.25, 0.0)),
+        ] {
+            let expected = base.powc(exponent);
+            for evaluator in [&original, &restored] {
+                let actual = evaluator.evaluate_single(&[base, exponent]);
+                assert!((actual - expected).norm() < 1e-13);
+            }
+        }
+    }
+
+    #[test]
+    fn direct_negative_integer_powers_use_reciprocal() {
+        for complex in [false, true] {
+            let mut config = Config::default();
+            config.set_opt_level(2);
+            config.set_direct(true);
+            config.set_complex(complex);
+            config.set_fastmath(false);
+            config.set_fast_complex(false);
+            config.set_simd(false);
+            let mut translator = DirectTranslator::new(config);
+            translator.set_num_params(1);
+            translator
+                .append_pow(&Slot::Out(0), &Slot::Param(0), -2, !complex)
+                .unwrap();
+            translator
+                .append_pow(&Slot::Out(1), &Slot::Param(0), -3, !complex)
+                .unwrap();
+            let evaluator = translator.compile().unwrap().seal().unwrap();
+            if complex {
+                let input = Complex::new(2., -1.);
+                let mut output = [Complex::new(0., 0.); 2];
+                evaluator.evaluate(&[input], &mut output);
+                for (actual, power) in output.into_iter().zip([-2, -3]) {
+                    assert!((actual - input.powi(power)).norm() < 1e-14);
+                }
+            } else {
+                let mut output = [0.; 2];
+                evaluator.evaluate(&[2.], &mut output);
+                assert_eq!(output, [0.25, 0.125]);
+            }
+        }
+    }
+
