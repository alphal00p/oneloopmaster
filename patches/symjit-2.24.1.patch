+    fn conditional_child(complex: bool) -> Applet {
+        let mut translator = Translator::new(config(complex));
+        translator.set_num_params(2);
+        translator.append_if_else(&Slot::Param(0), 1).unwrap();
+        translator
+            .append_assign(&Slot::Out(0), &Slot::Param(1))
+            .unwrap();
+        translator.append_goto(2).unwrap();
+        translator.append_label(1).unwrap();
+        translator
+            .append_add(&Slot::Out(0), &[Slot::Param(1), Slot::Param(1)], 0)
+            .unwrap();
+        translator.append_label(2).unwrap();
+        translator.compile().unwrap().seal().unwrap()
+    }
