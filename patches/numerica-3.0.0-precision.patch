+#![cfg(feature = "float-mpfr")]
+
+use numerica::domains::float::{Complex, Float, FloatLike, Real};
+
+fn compare_mpc(value: &Complex<Float>, root: &Complex<Float>, bits: u32) {
+    // MPC independently implements complex sqrt; promote the represented
+    // input values only in this reference, never in the production operation.
+    let reference =
+        rug::Complex::with_val(bits + 128, (value.re.as_raw(), value.im.as_raw())).sqrt();
+    for (actual, expected) in [(&root.re, reference.real()), (&root.im, reference.imag())] {
+        if expected.is_zero() {
+            assert!(actual.is_fully_zero(), "{value:?}: {root:?}");
+            assert_eq!(actual.is_sign_negative(), expected.is_sign_negative());
+        } else {
+            let delta = rug::Float::with_val(bits + 128, actual.as_raw() - expected).abs();
+            let mut tolerance = rug::Float::with_val(bits + 128, expected).abs();
+            tolerance >>= actual.prec().min(bits).saturating_sub(8);
+            assert!(delta <= tolerance, "{value:?}: {root:?} vs {reference:?}");
+        }
+    }
+}
+
+#[test]
+fn float_complex_sqrt_disparate_precision() {
+    for (bits, tiny_text) in [(512, "1e-154"), (3456, "1e-1100")] {
+        let tiny = Float::parse(tiny_text, Some(2)).unwrap();
+        for sign_re in [-1, 1] {
+            for sign_im in [-1, 1] {
+                let value = Complex::new(
+                    tiny.clone() * Float::with_val(2, sign_re),
+                    Float::with_val(bits, 1.25 * f64::from(sign_im)),
+                );
+                let root = value.sqrt();
+                assert!(root.re.prec() >= bits - 16, "{root:?}");
+                assert!(root.im.prec() >= bits - 16, "{root:?}");
+                compare_mpc(&value, &root, bits);
+
+                let value = Complex::new(
+                    Float::with_val(bits, 2 * sign_re),
+                    tiny.clone() * Float::with_val(2, sign_im),
+                );
+                let root = value.sqrt();
+                let (large, small) = if sign_re > 0 {
+                    (&root.re, &root.im)
+                } else {
+                    (&root.im, &root.re)
+                };
+                assert!(large.prec() >= bits - 16, "{root:?}");
+                assert!(small.prec() <= tiny.prec() + 4, "{root:?}");
+                compare_mpc(&value, &root, bits);
+            }
+        }
+    }
+}
+
+#[test]
+fn float_complex_sqrt_axes_and_extremes() {
+    for bits in [128, 3456] {
+        for x in [-4., -0., 0., 4.] {
+            for y in [-0., 0.] {
+                let value = Complex::new(Float::with_val(bits, x), Float::with_val(2, y));
+                compare_mpc(&value, &value.sqrt(), bits);
+            }
+        }
+        for y in [-4., 4.] {
+            let value = Complex::new(Float::with_val(2, 0), Float::with_val(bits, y));
+            compare_mpc(&value, &value.sqrt(), bits);
+        }
+        for text in ["1e-10000", "1e10000"] {
+            for sign in [-1, 1] {
+                let v = Float::parse(text, Some(bits)).unwrap();
+                let value = Complex::new(v.clone(), v * Float::with_val(bits, sign));
+                compare_mpc(&value, &value.sqrt(), bits);
+            }
+        }
+    }
+}
+
+#[test]
+fn float_complex_sqrt_component_precision_matrix() {
+    for real_bits in [2, 32, 128] {
+        for imaginary_bits in [2, 32, 128] {
+            for real_text in ["-1e100", "-1.25", "-1e-100", "1e-100", "1.25", "1e100"] {
+                for imaginary_text in ["-1e100", "-1.25", "-1e-100", "1e-100", "1.25", "1e100"] {
+                    let value = Complex::new(
+                        Float::parse(real_text, Some(real_bits)).unwrap(),
+                        Float::parse(imaginary_text, Some(imaginary_bits)).unwrap(),
+                    );
+                    compare_mpc(&value, &value.sqrt(), real_bits.max(imaginary_bits));
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn float_complex_sqrt_nonfinite_limits() {
+    let at = |v| Float::with_val(128, v);
+    for sign in [-1., 1.] {
+        for real in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY, 2.] {
+            let root = Complex::new(at(real), at(sign * f64::INFINITY)).sqrt();
+            assert_eq!(root.re, at(f64::INFINITY));
+            assert_eq!(root.im, at(sign * f64::INFINITY));
+        }
+        let root = Complex::new(at(f64::INFINITY), at(sign)).sqrt();
+        assert_eq!(root.re, at(f64::INFINITY));
+        assert!(root.im.is_fully_zero());
+        assert_eq!(root.im.is_sign_negative(), sign.is_sign_negative());
+        let root = Complex::new(at(f64::NEG_INFINITY), at(sign)).sqrt();
+        assert!(root.re.is_fully_zero());
+        assert!(!root.re.is_sign_negative());
+        assert_eq!(root.im, at(sign * f64::INFINITY));
+    }
+    for value in [
+        Complex::new(at(f64::NAN), at(0.)),
+        Complex::new(at(0.), at(f64::NAN)),
+        Complex::new(at(f64::NAN), at(f64::NAN)),
+    ] {
+        let root = value.sqrt();
+        assert!(root.re.as_raw().is_nan());
+        assert!(root.im.as_raw().is_nan());
+    }
+}
