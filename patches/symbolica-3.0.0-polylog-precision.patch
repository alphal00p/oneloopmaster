+#[test]
+fn polylog_thousand_digit_predicates_constants_and_caps() {
+    use super::{polylog_numeric_eval, polylog_series_integer};
+    use crate::domains::float::FloatLike;
+    const BITS: u32 = 3456;
+    let tiny = Float::parse("1e-1000", Some(BITS)).unwrap();
+    let z = Complex::new(Float::with_val(BITS, 0.25), Float::new(BITS));
+    let nonreal_order = Complex::new(Float::new(BITS), tiny.clone());
+    let value = polylog_numeric_eval(&nonreal_order, &z, BITS).unwrap();
+    assert!(!value.im.is_fully_zero(), "tiny order is not exact zero");
+    let almost_two = Complex::new(
+        Float::with_val(BITS, 2) + Float::with_val(BITS, 0.5).pow(200),
+        Float::new(BITS),
+    );
+    let nearby = polylog_numeric_eval(&almost_two, &z, BITS).unwrap();
+    let integer = polylog_numeric_eval(
+        &Complex::new(Float::with_val(BITS, 2), Float::new(BITS)),
+        &z,
+        BITS,
+    )
+    .unwrap();
+    assert!(
+        nearby.re < integer.re,
+        "near-integer order is not rounded to two"
+    );
+    // The high-order value differs from one beyond the old 900-bit limit.
+    let order = Complex::new(Float::with_val(BITS, 1002), Float::new(BITS));
+    let zeta = polylog_numeric_eval(&order, &complex_one(BITS), BITS).unwrap();
+    let mut expected = Float::new(BITS);
+    for n in 1..=32 {
+        expected += Float::with_val(BITS, 1) / Float::with_val(BITS, n).pow(1002);
+    }
+    assert_precision_complex(
+        &zeta,
+        &Complex::new(expected, Float::new(BITS)),
+        BITS,
+        "high-order zeta constant",
+    );
+    assert!(polylog_series_integer(2, &z, 128, u32::MAX).is_none());
+    assert!(polylog_integer_numeric_eval(2, &z, u32::MAX, 0).is_none());
+}
