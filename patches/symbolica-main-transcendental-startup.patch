+
+impl<T> Deref for SymbolCache<T> {
+    type Target = T;
+
+    fn deref(&self) -> &Self::Target {
+        if let Some(value) = self.value.get() {
+            return value;
+        }
+        let _ = State::get_global_state();
+        self.value.get_or_init(self.initialize)
+    }
+}
