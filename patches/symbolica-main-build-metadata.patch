@@ -0,0 +1,96 @@
+#[allow(dead_code)]
+#[path = "../build.rs"]
+mod build_script;
+
+use std::{
+    path::{Path, PathBuf},
+    process::Command,
+};
+
+struct Fixture(PathBuf);
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+fn git(directory: &Path, args: &[&str]) -> String {
+    let output = Command::new("git")
+        .current_dir(directory)
+        .args(args)
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    String::from_utf8(output.stdout).unwrap().trim().to_owned()
+}
+
+#[test]
+fn watches_existing_head_and_refs_in_clones_and_linked_worktrees() {
+    let unique = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_nanos();
+    let fixture = Fixture(
+        std::env::temp_dir().join(format!("symbolica-build-{}-{unique}", std::process::id())),
+    );
+    let repository = fixture.0.join("repository");
+    let worktree = fixture.0.join("worktree");
+    let archive = fixture.0.join("archive");
+    std::fs::create_dir_all(&repository).unwrap();
+    std::fs::create_dir_all(&archive).unwrap();
+    assert!(build_script::git_metadata_paths(&archive).is_empty());
+    git(&repository, &["init", "--initial-branch=main"]);
+    git(
+        &repository,
+        &[
+            "-c",
+            "user.name=Test",
+            "-c",
+            "user.email=test@example.invalid",
+            "commit",
+            "--allow-empty",
+            "-m",
+            "initial",
+        ],
+    );
+    git(
+        &repository,
+        &["worktree", "add", "--detach", worktree.to_str().unwrap()],
+    );
+    assert!(worktree.join(".git").is_file());
+    assert!(!worktree.join(".git/HEAD").exists());
+    for directory in [&repository, &worktree] {
+        let paths = build_script::git_metadata_paths(directory);
+        assert!(paths.iter().all(|p| p.is_absolute() && p.exists()));
+        let head = PathBuf::from(git(
+            directory,
+            &["rev-parse", "--path-format=absolute", "--git-path", "HEAD"],
+        ));
+        let reference = PathBuf::from(git(
+            directory,
+            &[
+                "rev-parse",
+                "--path-format=absolute",
+                "--git-path",
+                "refs/heads/main",
+            ],
+        ));
+        assert!(paths.contains(&head));
+        assert!(paths.iter().any(|p| reference.starts_with(p)));
+    }
+    git(&repository, &["pack-refs", "--all"]);
+    let packed = PathBuf::from(git(
+        &repository,
+        &[
+            "rev-parse",
+            "--path-format=absolute",
+            "--git-path",
+            "packed-refs",
+        ],
+    ));
+    assert!(build_script::git_metadata_paths(&worktree).contains(&packed));
+}
