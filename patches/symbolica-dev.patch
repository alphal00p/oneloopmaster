+#[cfg(test)]
+mod portable_tests {
+    use super::*;
+    use crate::{parse, symbol};
+
+    #[test]
+    fn jit_conjugate_uses_symjit_intrinsic() {
+        let evaluator = parse!("conj(jit_conjugate_x)")
+            .evaluator(&[parse!("jit_conjugate_x")])
+            .build()
+            .unwrap();
+        let mut compiled = evaluator
+            .jit_compile::<Complex<f64>>(JITCompilationSettings::new().optimization_level(2))
+            .unwrap();
+        let mut out = [Complex::new(0., 0.)];
+        compiled.evaluate(&[Complex::new(2., 3.)], &mut out);
+        assert_eq!(out, [Complex::new(2., -3.)]);
+    }
+
+    #[cfg(feature = "bincode")]
+    #[test]
+    fn portable_jit_restores_nested_complex_callbacks() {
+        let x = parse!("portable_jit_x");
+        let leaf = symbol!("portable_jit_leaf");
+        let outer = symbol!("portable_jit_outer");
+        let mut map = FunctionMap::new();
+        let options = FunctionRegistrationOptions::new().inlining(InliningPolicy::Never);
+        map.add_function_with_options(
+            leaf,
+            vec![symbol!("portable_jit_t")],
+            parse!("polylog(2,portable_jit_t) + polylog(2,1/4) + conj(portable_jit_t) + pi"),
+            options.clone(),
+        )
+        .unwrap();
+        map.add_function_with_options(
+            outer,
+            vec![symbol!("portable_jit_u")],
+            parse!("portable_jit_leaf(portable_jit_u) + portable_jit_leaf(portable_jit_u/2)"),
+            options,
+        )
+        .unwrap();
+        let evaluator = outer
+            .call((&x,))
+            .evaluator(std::slice::from_ref(&x))
+            .function_map(map)
+            .build()
+            .unwrap();
+        let settings = JITCompilationSettings::new().optimization_level(2);
+        let compiled = evaluator
+            .jit_compile::<Complex<f64>>(settings.clone())
+            .unwrap();
+        assert_eq!(compiled.input_count(), 1);
+        assert_eq!(compiled.output_count(), 1);
+        let bytes = compiled.export_portable().unwrap();
+        assert!(compiled.has_external_functions());
+        drop(compiled);
+        let mut restored =
+            JITCompiledEvaluator::<Complex<f64>>::import_portable(&bytes, settings.clone())
+                .unwrap();
+        assert_eq!(restored.input_count(), 1);
+        assert_eq!(restored.output_count(), 1);
+        assert_eq!(restored.code.config.opt_level(), 2);
+        // Applet/Defuns must own callbacks even after the wrapper holding their original copies
+        // is dropped, including after cloning a restored evaluator.
+        let mut cloned = restored.clone();
+        let mut reference = evaluator.map_coeff(&|c| Complex::new(c.re.to_f64(), c.im.to_f64()));
+        let mut out = [Complex::new(0., 0.)];
+        for input in [Complex::new(0.25, 0.), Complex::new(0.125, -0.25)] {
+            let expected = reference.evaluate_single(&[input]);
+            restored.evaluate(&[input], &mut out);
+            let difference = out[0] - expected;
+            assert!(difference.re.hypot(difference.im) < 1e-13);
+        }
+        drop(restored);
+        let input = Complex::new(-0.125, 0.25);
+        cloned.evaluate(&[input], &mut out);
+        let difference = out[0] - reference.evaluate_single(&[input]);
+        assert!(difference.re.hypot(difference.im) < 1e-13);
+        let mut trailing = bytes.clone();
+        trailing.push(0);
+        assert!(
+            JITCompiledEvaluator::<Complex<f64>>::import_portable(&trailing, settings.clone())
+                .is_err()
+        );
+        assert!(
+            JITCompiledEvaluator::<Complex<f64>>::import_portable(
+                &bytes[..bytes.len() / 2],
+                settings
+            )
+            .is_err()
+        );
+    }
+}
