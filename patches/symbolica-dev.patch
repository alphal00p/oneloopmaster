+#[test]
+fn float_complex_sqrt_axes_and_extremes() {
+    for bits in [128, 3456] {
+        for x in [-4., -0., 0., 4.] {
+            for y in [-0., 0.] {
+                let value = Complex::new(Float::with_val(bits, x), Float::with_val(2, y));
+                compare_mpc(&value, &value.sqrt(), bits);
+            }
+        }
+        for y in [-4., 4.] {
+            let value = Complex::new(Float::with_val(2, 0), Float::with_val(bits, y));
+            compare_mpc(&value, &value.sqrt(), bits);
+        }
+        for text in ["1e-10000", "1e10000"] {
+            for sign in [-1, 1] {
+                let v = Float::parse(text, Some(bits)).unwrap();
+                let value = Complex::new(v.clone(), v * Float::with_val(bits, sign));
+                compare_mpc(&value, &value.sqrt(), bits);
+            }
+        }
+    }
+}
