+#[cfg(feature = "bincode")]
+impl<T: bincode::Encode> JITCompiledEvaluator<T> {
+    /// Serialize portable intermediate code and its external function definitions.
+    ///
+    /// The result uses Symbolica's existing bincode representation, not native machine code.
+    /// It is intended for trusted artifacts using matching Symbolica and SymJIT versions.
+    pub fn export_portable(&self) -> Result<Vec<u8>, String> {
+        bincode::encode_to_vec(self, bincode::config::standard()).map_err(|e| e.to_string())
+    }
+}
+
+#[cfg(feature = "bincode")]
+impl<T: JITCompiledNumber + EvaluationDomain + Clone + bincode::Decode<()>>
+    JITCompiledEvaluator<T>
+{
+    /// Restore intermediate code and external definitions created by `export_portable`.
+    ///
+    /// Register any custom numerical symbol implementations before importing. Callbacks are
+    /// resolved from those registrations; process-specific function pointers are not serialized.
+    /// The top-level code retains its saved compilation settings. Supply the same settings here
+    /// for nested, non-inlined evaluators, which are recompiled during restoration.
+    pub fn import_portable(bytes: &[u8], settings: JITCompilationSettings) -> Result<Self, String> {
+        // Decode the payload, not Self: its ordinary Decode implementation immediately compiles
+        // nested evaluators with default settings, before the caller's settings could be applied.
+        let ((external_functions, compressed_ir), consumed) =
+            bincode::decode_from_slice::<(Vec<ExternalFunctionContainer<T>>, Vec<u8>), _>(
+                bytes,
+                bincode::config::standard(),
+            )
+            .map_err(|e| e.to_string())?;
+        if consumed != bytes.len() {
+            return Err("Trailing bytes in portable JIT evaluator".to_string());
+        }
+        Self::load_with_settings(compressed_ir, external_functions, settings)
+    }
+}
