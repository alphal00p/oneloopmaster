+        let mut previous: Option<Complex<Float>> = None;
+        for bits in [128, 256] {
+            let pi = Float::with_val(bits, Constant::Pi);
+            let z = Complex::new(
+                Float::with_val(bits, -1) / 2,
+                Float::with_val(bits, 3).sqrt() / 2,
+            );
+            let result = polylog_integer_numeric_eval(2, &z, bits, 0).unwrap();
+            // Re Li2(exp(2*pi*i/3)) = -pi^2/18, DLMF 25.12.8.
+            assert!((result.re.clone() + pi.pow(2) / 18).to_f64().abs() < 1e-28);
+            if let Some(old) = previous {
+                let delta = result.clone() - old;
+                assert!(delta.re.to_f64().hypot(delta.im.to_f64()) < 1e-28);
+            }
+            previous = Some(result);
+        }
+    }
