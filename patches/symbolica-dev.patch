+#[test]
+fn float_complex_sqrt_disparate_precision() {
+    for (bits, tiny_text) in [(512, "1e-154"), (3456, "1e-1100")] {
+        let tiny = Float::parse(tiny_text, Some(2)).unwrap();
+        for sign_re in [-1, 1] {
+            for sign_im in [-1, 1] {
+                let value = Complex::new(
+                    tiny.clone() * Float::with_val(2, sign_re),
+                    Float::with_val(bits, 1.25 * f64::from(sign_im)),
+                );
+                let root = value.sqrt();
+                assert!(root.re.prec() >= bits - 16, "{root:?}");
+                assert!(root.im.prec() >= bits - 16, "{root:?}");
+                compare_mpc(&value, &root, bits);
+
+                let value = Complex::new(
+                    Float::with_val(bits, 2 * sign_re),
+                    tiny.clone() * Float::with_val(2, sign_im),
+                );
+                let root = value.sqrt();
+                let (large, small) = if sign_re > 0 {
+                    (&root.re, &root.im)
+                } else {
+                    (&root.im, &root.re)
+                };
+                assert!(large.prec() >= bits - 16, "{root:?}");
+                assert!(small.prec() <= tiny.prec() + 4, "{root:?}");
+                compare_mpc(&value, &root, bits);
+            }
+        }
+    }
+}
