+#[test]
+fn float_complex_sqrt_component_precision_matrix() {
+    for real_bits in [2, 32, 128] {
+        for imaginary_bits in [2, 32, 128] {
+            for real_text in ["-1e100", "-1.25", "-1e-100", "1e-100", "1.25", "1e100"] {
+                for imaginary_text in ["-1e100", "-1.25", "-1e-100", "1e-100", "1.25", "1e100"] {
+                    let value = Complex::new(
+                        Float::parse(real_text, Some(real_bits)).unwrap(),
+                        Float::parse(imaginary_text, Some(imaginary_bits)).unwrap(),
+                    );
+                    compare_mpc(&value, &value.sqrt(), real_bits.max(imaginary_bits));
+                }
+            }
+        }
+    }
