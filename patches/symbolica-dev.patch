+            dilog_complex_f64, dilog_eval_complex_f64, dilog_eval_f64, polylog_eval_complex_f64,
+        };
+        let pi = std::f64::consts::PI;
+        for zero in [0.0, -0.0] {
+            assert_eq!(
+                dilog_complex_f64(Complex::new(0.0, zero)),
+                Complex::new(0.0, 0.0)
+            );
+            assert_eq!(
+                dilog_complex_f64(Complex::new(1.0, zero)),
+                Complex::new(pi * pi / 6.0, 0.0)
+            );
+            for x in [f64::from_bits(1.0_f64.to_bits() + 1), 2.0, 1e300] {
+                assert_eq!(dilog_complex_f64(Complex::new(x, zero)).im, -pi * x.ln());
+            }
+        }
+        let half = pi * pi / 12.0 - 0.5 * 2.0_f64.ln().powi(2);
+        assert!((dilog_eval_f64(&[0.5]) - half).abs() <= 2.0 * f64::EPSILON);
+        let upper = dilog_eval_complex_f64(&[Complex::new(2.0, f64::from_bits(1))]);
+        let lower = dilog_eval_complex_f64(&[Complex::new(2.0, -f64::from_bits(1))]);
+        assert!(upper.im > 0.0 && lower.im < 0.0);
+        assert_eq!(upper.re, lower.re);
+        assert_eq!(upper.im, -lower.im);
+        // Away from the cut, Im Li2(x+iy) = y*(-log(1-x)/x)+O(y^3).
+        // At these widths the cubic term is below the subnormal range. Check
+        // normal tiny components relatively, but explicitly allow two final
+        // subnormal ulps: the kernel does not promise correct rounding there.
+        let smallest = f64::from_bits(1);
+        for x in [-10.0_f64, -1.0, -0.5, 0.0, 0.5, 0.75] {
+            let derivative = if x == 0.0 { 1.0 } else { -(-x).ln_1p() / x };
+            for width in [-1e-300, 1e-300, -smallest, smallest] {
+                let actual = dilog_complex_f64(Complex::new(x, width)).im;
+                let expected = width * derivative;
+                assert!(
+                    (actual - expected).abs()
+                        <= 24.0 * f64::EPSILON * expected.abs() + 2.0 * smallest,
+                    "tiny width at {x}+i*{width}: {actual:e} vs {expected:e}"
+                );
+            }
+        }
+        assert!(dilog_eval_f64(&[]).is_nan());
+        assert!(dilog_eval_complex_f64(&[]).re.is_nan());
+        for z in [
+            Complex::new(f64::NAN, 0.0),
+            Complex::new(f64::INFINITY, 0.0),
+        ] {
+            let fallback = polylog_eval_complex_f64(
+                Some(Complex::new(Float::with_val(53, 2), Float::new(53))),
+                &[z],
+            );
+            let actual = dilog_eval_complex_f64(&[z]);
+            for (a, b) in [(actual.re, fallback.re), (actual.im, fallback.im)] {
+                assert!(a == b || a.is_nan() && b.is_nan());
+            }
+        }
+    }
