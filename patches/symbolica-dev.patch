+    debug_assert!(z.re.is_finite() && z.im.is_finite());
+    if z.im == 0.0 {
+        if z.re == 0.0 {
+            return Complex::new(0.0, 0.0);
+        }
+        if z.re == 1.0 {
+            return Complex::new(PI_SQUARED_OVER_SIX, 0.0);
+        }
+        if z.re == -1.0 {
+            return Complex::new(-PI_SQUARED_OVER_SIX / 2.0, 0.0);
+        }
+    }
