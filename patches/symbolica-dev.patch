+/// Principal binary64 dilogarithm for finite complex arguments.
+///
+/// Inversion (DLMF 25.12.4) followed by reflection (25.12.6, analytically
+/// continued off the cut) reduces to |u| <= 1, Re(u) <= 1/2. With
+/// w=-log(1-u), d Li2(1-exp(-w))/dw = w/(exp(w)-1), hence
+/// Li2(u)=w-w^2/4+sum B(2k)*w^(2k+1)/(2k+1)!.
+/// On this domain |w| <= hypot(log(2), pi/3). The omitted tail after B28 is
+/// bounded by 2*zeta(2)*|w|*q^15/(31*(1-q)) < 1.5e-22, q=|w/(2*pi)|^2.
+/// This is a truncation bound, not a bound on binary64 arithmetic/log errors
+/// or a correct-rounding guarantee. Arbitrary-precision evaluation is unchanged.
+/// References: https://dlmf.nist.gov/25.12 and https://dlmf.nist.gov/24.2.E1.
+fn dilog_complex_f64(z: Complex<f64>) -> Complex<f64> {
+    use std::f64::consts::PI;
+    const PI_SQUARED_OVER_SIX: f64 = std::f64::consts::PI * std::f64::consts::PI / 6.0;
