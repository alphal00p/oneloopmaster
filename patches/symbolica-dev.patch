-    println!("cargo:rerun-if-changed=.git/HEAD");
+    // In a linked worktree `.git` is a file; watching `.git/HEAD` then watches a
+    // nonexistent path and forces the entire library to rebuild on every run.
+    // Ask Git for the real metadata locations, including loose/packed refs.
+    for entry in ["HEAD", "refs", "packed-refs"] {
+        if let Ok(output) = Command::new("git")
+            .args(["rev-parse", "--git-path", entry])
+            .output()
+            && output.status.success()
+            && let Ok(path) = String::from_utf8(output.stdout)
+            && std::path::Path::new(path.trim()).exists()
+        {
+            println!("cargo:rerun-if-changed={}", path.trim());
+        }
+    }
     println!("cargo:rerun-if-changed=build.rs");
 }
